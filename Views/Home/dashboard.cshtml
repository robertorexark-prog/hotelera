
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hotel - Panel de Usuario</title>
    <style>
        :root {
            --bg-color: #121212;
            --surface-color: #1e1e1e;
            --text-color: #e0e0e0;
            --primary-color: #bb86fc;
            --secondary-color: #03dac6;
            --danger-color: #cf6679;
        }
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        nav {
            background-color: var(--surface-color);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }
        nav a {
            color: var(--primary-color);
            text-decoration: none;
            margin-left: 1.5rem;
            font-weight: bold;
        }
        main {
            padding: 2rem;
            flex: 1;
        }
        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }
        .card-stats {
            display: flex;
            gap: 20px;
            margin-bottom: 2rem;
        }
        .stat-box {
            background-color: var(--surface-color);
            padding: 1.5rem;
            border-radius: 8px;
            flex: 1;
            text-align: center;
            box-shadow: 0 4px 6px rgba(0,0,0,0.2);
        }
        .stat-box h3 {
            margin: 0;
            font-size: 2rem;
            color: var(--primary-color);
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background-color: var(--surface-color);
            border-radius: 8px;
            overflow: hidden;
        }
        th, td {
            padding: 1rem;
            text-align: left;
            border-bottom: 1px solid #333;
        }
        th {
            background-color: #2c2c2c;
            color: var(--secondary-color);
        }
        tr:hover {
            background-color: #2a2a2a;
        }
        .badge {
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
            font-size: 0.85rem;
            font-weight: bold;
        }
        .badge-success { background-color: rgba(3, 218, 198, 0.2); color: var(--secondary-color); }
        .badge-pending { background-color: rgba(187, 134, 252, 0.2); color: var(--primary-color); }
        .badge-danger { background-color: rgba(207, 102, 121, 0.2); color: var(--danger-color); }
    </style>
</head>
<body>
    <nav>
        <div style="font-size: 1.5rem; font-weight: bold;">HotelReservas</div>
        <div>
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <a asp-controller="Home" asp-action="Reservas">Reservar</a>
            <a asp-controller="Home" asp-action="Dashboard">Mi Panel</a>
        </div>
    </nav>
    <main>
        <div class="dashboard-header">
            <h2>Panel de Administración / Usuario</h2>
        </div>
        
        <div class="card-stats">
            <div class="stat-box">
                <h3>3</h3>
                <p>Reservas Activas</p>
            </div>
            <div class="stat-box">
                <h3>$5,800</h3>
                <p>Pagos Pendientes</p>
            </div>
            <div class="stat-box">
                <h3>1</h3>
                <p>Interacciones Bot (Hoy)</p>
            </div>
        </div>

        <h3>Historial de Reservas (Tabla: reservas)</h3>
        <table>
            <thead>
                <tr>
                    <th>ID Reserva</th>
                    <th>Habitación</th>
                    <th>Check-In</th>
                    <th>Check-Out</th>
                    <th>Total</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>#1001</td>
                    <td>101 (Sencilla)</td>
                    <td>2026-10-15</td>
                    <td>2026-10-18</td>
                    <td>$2,400.00</td>
                    <td><span class="badge badge-success">Confirmada</span></td>
                </tr>
                <tr>
                    <td>#1002</td>
                    <td>205 (Doble)</td>
                    <td>2026-10-20</td>
                    <td>2026-10-22</td>
                    <td>$3,000.00</td>
                    <td><span class="badge badge-pending">En curso</span></td>
                </tr>
                <tr>
                    <td>#1003</td>
                    <td>301 (Suite)</td>
                    <td>2026-09-01</td>
                    <td>2026-09-05</td>
                    <td>$14,000.00</td>
                    <td><span class="badge badge-danger">Cancelada</span></td>
                </tr>
            </tbody>
        </table>
    </main>
</body>
</html>
@model HomeIndexViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Inicio";
    var mx = CultureInfo.GetCultureInfo("es-MX");
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
}

@section Hero {
    <div class="row align-items-center g-4 g-lg-5">
        <div class="col-lg-6">
            <span class="hv-pill mb-3">Renta de habitaciones</span>
            <h1 class="mt-3 mb-3">Encuentra tu habitación ideal</h1>
            <p class="mb-4">Elige tus fechas, dinos cuántos viajan y compara nuestros tipos de habitación en un solo lugar.</p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" href="#tipos-habitacion">Ver habitaciones</a>
                <a class="btn btn-outline-light" asp-controller="Reservas" asp-action="Index">Mis Reservas</a>
            </div>
        </div>

        <div class="col-lg-6">
            <form class="hv-search" method="get" asp-controller="Home" asp-action="Index" asp-fragment="tipos-habitacion" role="search">
                <h2 class="hv-search-title">Búsqueda rápida</h2>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="Busqueda.FechaEntrada" class="form-label"></label>
                        <input asp-for="Busqueda.FechaEntrada" class="form-control" min="@hoy" />
                        <span asp-validation-for="Busqueda.FechaEntrada" class="hv-field-error"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Busqueda.FechaSalida" class="form-label"></label>
                        <input asp-for="Busqueda.FechaSalida" class="form-control" min="@hoy" />
                        <span asp-validation-for="Busqueda.FechaSalida" class="hv-field-error"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Busqueda.Huespedes" class="form-label"></label>
                        <select asp-for="Busqueda.Huespedes" class="form-select">
                            @for (var i = 1; i <= 6; i++)
                            {
                                <option value="@i">@i @(i == 1 ? "huésped" : "huéspedes")</option>
                            }
                        </select>
                        <span asp-validation-for="Busqueda.Huespedes" class="hv-field-error"></span>
                    </div>
                    <div class="col-sm-6 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Buscar habitaciones</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

<section id="tipos-habitacion" class="hv-section">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
        <div>
            <p class="hv-eyebrow mb-1">Hospedaje</p>
            <h2 class="mb-1">Tipos de habitación</h2>
            <p class="hv-muted mb-0">Precios base por noche. El total se calcula al reservar.</p>
        </div>

        @if (Model.HayBusqueda)
        {
            <div class="d-flex align-items-center gap-2">
                <span class="hv-pill">
                    @Model.Busqueda.Huespedes @(Model.Busqueda.Huespedes == 1 ? "huésped" : "huéspedes")
                    @if (Model.Busqueda.FechaEntrada.HasValue && Model.Busqueda.FechaSalida.HasValue)
                    {
                        <text>· @Model.Busqueda.FechaEntrada.Value.ToString("d MMM", mx) – @Model.Busqueda.FechaSalida.Value.ToString("d MMM", mx)</text>
                    }
                </span>
                <a class="small" asp-controller="Home" asp-action="Index" asp-fragment="tipos-habitacion">Limpiar</a>
            </div>
        }
    </div>

    @if (!Model.Habitaciones.Any())
    {
        <div class="hv-card">
            <p class="mb-0 hv-muted">No hay tipos de habitación para @Model.Busqueda.Huespedes huéspedes. Prueba con menos personas.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var habitacion in Model.Habitaciones)
            {
                <div class="col">
                    <article class="hv-room-card">
                        <div class="hv-room-media hv-room-media-@(habitacion.IdTipoHab % 4)">
                            @if (!string.IsNullOrEmpty(habitacion.UrlImagen))
                            {
                                <img src="@habitacion.UrlImagen" alt="Habitación @habitacion.NombreTipo" loading="lazy" />
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 18V7" /><path d="M21 18v-5a3 3 0 0 0-3-3h-7v5" /><path d="M3 15h18" /><circle cx="7" cy="11" r="2" /></svg>
                            }
                        </div>

                        <div class="hv-room-body">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="hv-tag">Habitación</span>
                                <span class="hv-muted small">Hasta @habitacion.CapacidadMaxima @(habitacion.CapacidadMaxima == 1 ? "huésped" : "huéspedes")</span>
                            </div>
                            <h3 class="hv-room-title">@habitacion.NombreTipo</h3>
                            <p class="hv-muted small mb-0">@habitacion.Descripcion</p>
                        </div>

                        <div class="hv-room-footer">
                            <div>
                                <span class="hv-muted small d-block">Desde</span>
                                <span class="hv-price">@habitacion.PrecioBase.ToString("C0", mx) <small>MXN / noche</small></span>
                            </div>
                            <a class="btn btn-primary btn-sm" asp-controller="Habitaciones" asp-action="Detalle" asp-route-id="@habitacion.IdTipoHab">Ver detalle</a>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>
